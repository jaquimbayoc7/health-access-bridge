# Servicio ICF local (HU-07). Copiar a .env y completar. NUNCA subir el .env al repositorio.
ICF_DB_USER=icf_user
ICF_DB_PASSWORD=CHANGE_ME
ICF_DB_NAME=icf
# La base solo escucha en 127.0.0.1:5433 del servidor
ICF_DATABASE_URL=postgresql://icf_user:CHANGE_ME@127.0.0.1:5433/icf

# Ollama corre en el propio servidor (instalacion nativa)
OLLAMA_URL=http://127.0.0.1:11434
ICF_EMBED_MODEL=bge-m3
# Minimo viable provisional (HU-07f): gemma4:e4b. Gemma 4 razona antes de responder: apagarlo con ICF_LLM_THINK=false.
ICF_LLM_MODEL=gemma4:e4b
ICF_LLM_THINK=false
# ICF_LLM_NUM_GPU=0   # fuerza CPU (para dimensionar equipos sin GPU)
